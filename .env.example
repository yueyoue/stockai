# StockAI Environment Configuration

# JWT Secret Key (change in production!)
SECRET_KEY=your-secret-key-here

# LLM Configuration
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Database (managed by docker-compose, no need to change)
# DATABASE_URL=postgresql+asyncpg://stockai:stockai123@stock-db:5432/stockai

# Redis (managed by docker-compose)
# REDIS_URL=redis://stock-redis:6379/0

# Crawler Settings
CRAWLER_INTERVAL_MINUTES=30
